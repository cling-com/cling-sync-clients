<?xml version="1.0" encoding="utf-8"?><!--
   Used on Android 11 and below (API <= 30). android:allowBackup="false" already
   disables backup there; this excludes every domain so that, even if backup were
   re-enabled, no app data (passphrase store, encrypted S3 credential URI, file-hash
   caches) is ever included.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
